# GEMINI_API_KEY: Required for AI Research module (Gemini 2.5/LangChain integration)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# London Strategic Edge Institutional Feed API Key
# If omitted, FinTechStation operates in explicit HIGH-FIDELITY SIMULATION DEMO MODE.
LONDON_STRATEGIC_EDGE_API_KEY=""
LONDON_STRATEGIC_EDGE_API_URL="https://api.londonstrategicedge.com/v1"

# Spring Boot & Database Configuration
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/fintechstation"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD="postgrespassword"

# Kafka & Spark Streaming
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
SPARK_MASTER_URL="spark://localhost:7077"
